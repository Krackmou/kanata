#|
Source(azerty):
  grv  &    é    "    '    (    -    è    _    ç    à    )    =    bspc
  tab  a    z    e    r    t    y    u    i    o    p    ^    $    ret
  caps q    s    d    f    g    h    j    k    l    m    ù    * ret
  lsft <    w    x    c    v    b    n    ,    ;    :    !    rsft
  lctl lmet lalt         spc              ralt rmet rctl

Main(custom colemak-dh):
  grv         1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab         q    w    f    p    b    j    l    u    y    '    [    ]    z
  Code-toggle a    r    s    t    g    m    n    e    i    o    '    ret
  lsft        x    c    d    v    z    k    h    ,    .    /    rsft
  lctl lmet esc        Accent-toggle            ralt rmet rctl
|#

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  ;; Les noms des touches correspondent maintenant à une disposition AZERTY
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  a    z    e    r    t    y    u    i    o    p    [    ]    \
  caps q    s    d    f    g    h    j    k    l    m    '    ret
  lsft w    x    c    v    b    n    ,    ;    .    /    rsft ; Note: les touches physiques sont les mêmes
  lctl lmet lalt         spc              ralt rmet rctl
)

(defvar
  streak-count 3
  streak-time 325
  tap-timeout 200
  hold-timeout 1000
  chord-timeout 50
)

(deftemplate charmod (char mod)
  (switch
    ((key-timing $streak-count less-than $streak-time)) $char break
    () (tap-hold-release-timeout $tap-timeout $hold-timeout $char $mod $char) break
  )
)

(defvirtualkeys
  shift (multi (layer-switch main) lsft)
  clear (multi (layer-switch main) (on-press release-virtualkey shift))
)

;; ## MODIFICATION PRINCIPALE ##
;; Ce bloc mappe maintenant directement les touches AZERTY (du defsrc)
;; vers la disposition Colemak-DH que vous souhaitez.
(deflayermap (main)
  ;; AZERTY Source -> Colemak-DH Target

  ;; Ligne du haut (basée sur la position physique)
  a q         ; La touche 'a' (AZERTY) donne 'q' (Colemak)
  z w         ; La touche 'z' (AZERTY) donne 'w' (Colemak)
  e f
  r p
  t b
  y j
  u l
  i u
  o y
  p @e-acute  ; Unicode, inchangé

  ;; Ligne du milieu (Home Row)
  q a         ; La touche 'q' (AZERTY) donne 'a' (Colemak)
  s r
  d s
  f t
  g g
  h m
  j n
  k e
  l i
  m o         ; La touche 'm' (AZERTY) donne 'o' (Colemak)
  ' @e-acute  ; Mapping pour votre touche apostrophe vers un 'é' comme dans l'original

  ;; Ligne du bas
  w x         ; La touche 'w' (AZERTY) donne 'x' (Colemak)
  x c
  c d
  v v
  b z
  n k
  , h         ; La touche ',' (AZERTY) donne 'h' (Colemak)
  ; ,         ; La touche ';' (AZERTY) donne ',' (Colemak)
  . .         ; La touche '.' (AZERTY) donne '.' (Colemak)
  / /         ; La touche '/' (AZERTY) donne '/' (Colemak)
  \ z         ; Vous aviez un 'z' sur la touche '\'

  ;; Touches spéciales
  spc (t! charmod spc (multi (layer-switch extend) (on-release tap-virtualkey clear)))
  caps (layer-toggle code)
  alt esc
)

(defalias
  a-circ (fork (unicode â) (unicode Â) (lsft rsft))
  e-circ (fork (unicode ê) (unicode Ê) (lsft rsft))
  u-circ (fork (unicode û) (unicode Û) (lsft rsft))
  i-circ (fork (unicode î) (unicode Î) (lsft rsft))
  a-grav (fork (unicode à) (unicode À) (lsft rsft))
  e-grav (fork (unicode è) (unicode È) (lsft rsft))
  e-acute (fork (unicode é) (unicode É) (lsft rsft))
  i-trema (fork (unicode ï) (unicode Ï) (lsft rsft))
  o-circ (fork (unicode ô) (unicode Ô) (lsft rsft))
  c-cedil (fork (unicode ç) (unicode Ç) (lsft rsft))
  simple-e    (unicode ê)
  at-sign     (unicode @)
  hash-sign   (unicode #)
  dollar      (unicode $)
  percent     (unicode %)
  caret       (unicode ^)
  ampersand   (unicode &)
  asterisk    (unicode *)
  euro        (unicode €)
  lparen      (unicode "(")
  rparen      (unicode ")")
  minus       (unicode -)
  underscore  (unicode _)
  equal       (unicode =)
  plus        (unicode +)
  lbracket    (unicode [)
  rbracket    (unicode ])
  lbrace      (unicode {)
  rbrace      (unicode })
  backslash   (unicode \)
  pipe        (unicode |)
  twopoints   (unicode :)
  apostrophe_inversée    (unicode `)
  tilde       (unicode ~)
  trademark (unicode ™)
  point-virgule (unicode ;)
  exclamation (unicode !)
  interrogation (unicode ?)
  smaller_than (unicode <)
  bigger_than (unicode >)
  two 2
  zero 0
  seven 7
  mail_address (macro d u r a n d . a l e x a n d r e .  @two @zero @zero @seven @at-sign g m a i l . c o m)
  peut-être (macro p e u t  @minus @simple-e 10 t r e)
  dû (macro d (unicode û))
  où (macro o (unicode ù))
  ça (macro (unicode ç) a)
)

;; Les accords ont été mis à jour pour utiliser les noms de touches AZERTY du defsrc
(defchordsv2
  (z e) esc         100 all-released  ()
  (o p) @où         100 all-released  ()
  (c u) @dû         100 all-released  ()
  (. /) ret         100 all-released  ()
  (' ,) @e-grav     100 all-released  () ; Changé de (m ,) à (',') pour AZERTY
  (f h) @trademark  100 all-released  ()
  (r t) @peut-être  100 all-released  ()
  (e r) bspc        100 all-released  ()
  (e r z) C-bspc    100 all-released  ()
)

;; Les couches ont été mises à jour pour utiliser les noms de touches AZERTY du defsrc
(deflayermap (extend)
  a @a-circ
  u @e-circ
  i @u-circ
  o @i-circ
  q @a-grav
  j @e-grav
  l @i-trema
  m @o-circ
  c @c-cedil
)

(deflayermap (code)
  a   @percent
  z   @asterisk
  e   @equal
  r   @plus
  t   @backslash
  y   @pipe
  u   /
  i   @exclamation
  o   @interrogation
  p   f11
  q   @smaller_than
  s   @bigger_than
  d   @at-sign
  f   @hash-sign
  g   @underscore
  h   @minus
  j   @twopoints
  k   @point-virgule
  l   @lparen
  m   @rparen
  '   @apostrophe_inversée
  w   @mail_address
  x   @tilde
  c   @lbracket
  v   @rbracket
  b   @caret
  n   @ampersand
  ,   @lbrace
  ;   @rbrace
  .   @euro
  /   @dollar
  spc spc
)

